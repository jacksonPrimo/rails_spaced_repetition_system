<%- if controller_name != 'sessions' %>
  <p class="mt-2 text-center text-sm text-gray-500"><%= link_to "Já tem uma conta?", new_session_path(resource_name), class: "font-semibold leading-6 text-indigo-600 hover:text-indigo-500" %></p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p class="mt-2 text-center text-sm text-gray-500"><%= link_to "Ainda não tem uma conta?", new_registration_path(resource_name), class: "font-semibold leading-6 text-indigo-600 hover:text-indigo-500" %></p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p class="mt-2 text-center text-sm text-gray-500"><%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "font-semibold leading-6 text-indigo-600 hover:text-indigo-500" %></p>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <p class="mt-2 text-center text-sm text-gray-500"><%= link_to "Não recebeu as instruções de confirmação?", new_confirmation_path(resource_name), class: "font-semibold leading-6 text-indigo-600 hover:text-indigo-500" %></p>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <p class="mt-2 text-center text-sm text-gray-500"><%= link_to "Não recebeu as instruções de desbloqueio?", new_unlock_path(resource_name), class: "font-semibold leading-6 text-indigo-600 hover:text-indigo-500" %></p>
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <p class="mt-2 text-center text-sm text-gray-500"><%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false } %></p>
  <% end %>
<% end %>
